(in-package :jarvis.plane.model)

(defstruct (frame (:constructor %make-frame))
  name parent (ox 0d0) (oy 0d0) (rotation 0d0) (scale 1d0))

(defparameter *world-frame* (%make-frame :name 'world))
(defparameter *frames* (make-hash-table :test #'eq))
(defparameter *entity-registry* (make-hash-table :test #'eq))
(defparameter *param-kinds* (make-hash-table :test #'eq))
(defparameter *entity-types* (make-hash-table :test #'eq))

(setf (gethash 'world *frames*) *world-frame*)

(defun make-frame (name &key parent (ox 0d0) (oy 0d0) (rotation 0d0)
                              (scale 1d0))
  (let ((new-frame (%make-frame :name name :parent (or parent *world-frame*)
                                :ox ox :oy oy :rotation rotation :scale scale)))
    (setf (gethash name *frames*) new-frame)
    new-frame))

(defun rotate (x y angle)
  (let ((c (cos angle)) (s (sin angle)))
    (values (- (* c x) (* s y)) (+ (* s x) (* c y)))))

(defun frame->world (frame x y)
  (if (null frame)
      (values x y)
      (multiple-value-bind (rx ry) (rotate (* (frame-scale frame) x)
                                            (* (frame-scale frame) y)
                                            (frame-rotation frame))
        (multiple-value-bind (px py) (frame->world (frame-parent frame)
                                                    (+ (frame-ox frame) rx)
                                                    (+ (frame-oy frame) ry))
          (values px py)))))

(defun world->frame (frame x y)
  (if (or (null frame) (eq frame *world-frame*))
      (values x y)
      (multiple-value-bind (px py) (world->frame (frame-parent frame) x y)
        (multiple-value-bind (rx ry) (rotate (- px (frame-ox frame))
                                             (- py (frame-oy frame))
                                             (- (frame-rotation frame)))
          (values (/ rx (frame-scale frame)) (/ ry (frame-scale frame)))))))

(defun assert-plane-fact (predicate &rest args)
  (jarvis.knowledge:store-fact
   (apply #'jarvis.knowledge:make-fact predicate args)))

(defun add-primitive (predicate name &rest args)
  (apply #'assert-plane-fact predicate name args))

(defun add-point (name frame x y) (add-primitive 'point name frame x y))
(defun add-vector (name frame x y) (add-primitive 'vector name frame x y))
(defun add-line (name frame a b c) (add-primitive 'line name frame a b c))
(defun add-segment (name p1 p2) (add-primitive 'segment name p1 p2))
(defun add-circle (name frame cx cy r) (add-primitive 'circle name frame cx cy r))
(defun add-polygon (name &rest points) (apply #'add-primitive 'polygon name points))
(defun add-curve (name frame x-expr y-expr t0 t1)
  (add-primitive 'curve name frame x-expr y-expr t0 t1))

(defun def-param-kind (name &key dimension (bounds '(nil nil)) default-unit)
  (setf (gethash name *param-kinds*)
        (list :dimension dimension :bounds bounds :default-unit default-unit)))

(defun declare-predicate-dims (predicate dimensions)
  (setf (gethash predicate *param-kinds*) dimensions))

(defun def-entity-type (type &key params)
  (setf (gethash type *entity-types*) params))

(defun add-entity (name type &key params)
  (unless (gethash type *entity-types*)
    (error "Unknown entity type ~A" type))
  (setf (gethash name *entity-registry*) type)
  (assert-plane-fact 'entity name type)
  (dolist (param params)
    (apply #'set-param name (first param) (rest param)))
  name)

(defun set-param (entity name value &key status unit bounds sigma)
  (declare (ignore status unit sigma))
  (let ((limits (or bounds (getf (gethash name *param-kinds*) :bounds))))
    (when (and limits (first limits) (< value (first limits)))
      (error "Parameter ~A is below its lower bound" name))
    (when (and limits (second limits) (> value (second limits)))
      (error "Parameter ~A exceeds its upper bound" name))
    (assert-plane-fact 'param entity name value)
    value))

(defun clear-plane ()
  (clrhash *frames*)
  (setf (gethash 'world *frames*) *world-frame*)
  (clrhash *entity-registry*)
  (values))
