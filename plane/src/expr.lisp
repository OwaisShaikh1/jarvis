(in-package :jarvis.plane.expr)

(define-condition eval-error (error)
  ((message :initarg :message :reader eval-error-message)))
(define-condition dimension-mismatch (error) ())
(define-condition inexact-in-rational-domain (error) ())

(defun bound-value (symbol bindings)
  (let ((cell (assoc symbol bindings :test #'eq)))
    (if cell (cdr cell)
        (error 'eval-error :message (format nil "Unbound variable ~A" symbol)))))

(defun evaluate (expr bindings &key (policy (jarvis.plane.numeric:make-numeric-policy)))
  (cond
    ((numberp expr) expr)
    ((symbolp expr) (bound-value expr bindings))
    ((consp expr)
     (let ((op (string-downcase (symbol-name (first expr))))
           (args (rest expr)))
       (labels ((ev () (mapcar (lambda (x) (evaluate x bindings :policy policy)) args))
                (one () (first (ev))))
         (case (intern (string-upcase op) :keyword)
           (:+ (apply #'+ (ev)))
           (:- (if (cdr args) (apply #'- (ev)) (- (one))))
           (:* (apply #'* (ev)))
           (:/ (apply #'/ (ev)))
           (:EXPT (expt (first (ev)) (second (ev))))
           (:SQRT (sqrt (one)))
           (:SIN (sin (one)))
           (:COS (cos (one)))
           (:TAN (tan (one)))
           (:ATAN2 (atan (first (ev)) (second (ev))))
           (:EXP (exp (one)))
           (:LOG (log (one)))
           (:ABS (abs (one)))
           (:MIN (apply #'min (ev)))
           (:MAX (apply #'max (ev)))
           (:= (jarvis.plane.numeric:numbers-match-p
                (first (ev)) (second (ev))
                (jarvis.plane.numeric:effective-policy :global 0 nil)))
           (:DISTINCT (not (eq (first (ev)) (second (ev)))))
           (otherwise
            (error 'eval-error
                   :message (format nil "operator not allowed: ~A" op)))))))
    (t (error 'eval-error :message "invalid expression"))))

(defun expr-dimension (expr var-dims)
  (cond
    ((numberp expr) '(0 0 0 0 0))
    ((symbolp expr) (or (cdr (assoc expr var-dims :test #'eq))
                        (error 'dimension-mismatch)))
    ((consp expr)
     (let ((op (intern (string-upcase (symbol-name (first expr))) :keyword))
           (dims (mapcar (lambda (x) (expr-dimension x var-dims)) (rest expr))))
       (case op
         ((:+ :- :MIN :MAX := :/= :< :> :<= :>=)
          (unless (every (lambda (x) (jarvis.plane.units:dim= x (first dims)))
                         (rest dims))
            (error 'dimension-mismatch))
          (first dims))
         (:* (reduce #'jarvis.plane.units:dim* dims))
         (:/ (reduce #'jarvis.plane.units:dim/ dims))
         (:EXPT (jarvis.plane.units:dim-expt (first dims)
                                              (second (rest expr))))
         (:SQRT (jarvis.plane.units:dim-expt (first dims) 1/2))
         ((:SIN :COS :TAN :EXP :LOG)
          (unless (jarvis.plane.units:dim= (first dims) '(0 0 0 0 0))
                                        (error 'dimension-mismatch))
          '(0 0 0 0 0))
         (:ABS (first dims))
         (otherwise (error 'dimension-mismatch)))))
    (t (error 'dimension-mismatch))))
